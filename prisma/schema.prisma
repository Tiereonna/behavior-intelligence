// Phase comes from the session date. There is no phaseId on Measurement.
// User, account, and session tables are unused. Login is not built.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection string is in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  MEMBER
}

enum MeasurementType {
  FREQUENCY
  RATE
  DURATION
  PERCENTAGE
  LATENCY
  INTERVAL
}

enum MeasurementUnit {
  COUNT
  PER_HOUR
  PERCENT
  SECONDS
}

enum ValueState {
  /// An ordinary observed number.
  VALUE
  /// The true value lies beyond the observation window. Used for latency when
  /// the behavior never occurred: `normalizedValue` holds the lower bound
  /// (the session length), and the real value is "at least" that much.
  CENSORED
  /// The session happened but this behavior could not be measured — no
  /// opportunities arose, or the antecedent was never presented.
  NOT_APPLICABLE
}

enum BehaviorDirection {
  /// More of this behavior is the goal (e.g. independent requests).
  INCREASE
  /// Less of this behavior is the goal (e.g. elopement).
  DECREASE
}

enum PhaseType {
  BASELINE
  INTERVENTION
  MAINTENANCE
  REVERSAL
}

// Login tables. The app does not read these.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  observedSessions ObservationSession[] @relation("SessionObserver")
  auditLogs        AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// auth_sessions, not an observation session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

// Client.organizationId points here. Nothing signs a user in.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

// Display name only. No real client records.
model Client {
  id             String    @id @default(cuid())
  organizationId String
  /// Initials or a pseudonym, e.g. "J.M." — not a legal name.
  displayName    String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  behaviors    Behavior[]
  sessions     ObservationSession[]

  @@index([organizationId, archivedAt])
  @@map("clients")
}

model Behavior {
  id String @id @default(cuid())

  clientId String

  name String

  operationalDefinition String

  measurementType MeasurementType

  measurementConfig Json @default("{}")

  direction BehaviorDirection

  targetValue Float?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phases       Phase[]
  measurements Measurement[]
  annotations  Annotation[]

  @@index([clientId, archivedAt])
  @@map("behaviors")
}

// [startDate, endDate). A null endDate means the phase is still open.
model Phase {
  id         String    @id @default(cuid())
  behaviorId String
  /// Free text, e.g. "DRA + break card".
  name       String
  phaseType  PhaseType
  startDate  DateTime  @db.Date
  /// Null means ongoing. At most one open-ended phase per behavior.
  endDate    DateTime? @db.Date

  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  behavior Behavior @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@index([behaviorId, startDate])
  @@map("phases")
}

// Duration lives on the session. Rate divides by it.
model ObservationSession {
  id       String  @id @default(cuid())
  clientId String
  observerId String?

  sessionDate DateTime @db.Date

  startTime String?

  durationMinutes Int
  setting         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  observer     User?         @relation("SessionObserver", fields: [observerId], references: [id], onDelete: SetNull)
  measurements Measurement[]

  @@index([clientId, sessionDate])
  @@map("observation_sessions")
}

// 0 means the behavior did not happen. No row means it was not scored.
model Measurement {
  id                   String @id @default(cuid())
  observationSessionId String
  behaviorId           String

  measurementType MeasurementType

  rawEntry Json

  // null when valueState is NOT_APPLICABLE
  normalizedValue Float?

  valueState ValueState      @default(VALUE)
  unit       MeasurementUnit

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observationSession ObservationSession @relation(fields: [observationSessionId], references: [id], onDelete: Cascade)
  behavior           Behavior           @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@unique([observationSessionId, behaviorId])
  @@index([behaviorId])
  @@map("measurements")
}

model Annotation {
  id         String   @id @default(cuid())
  behaviorId String
  occurredOn DateTime @db.Date
  title      String
  body       String?
  createdAt  DateTime @default(now())

  behavior Behavior @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@index([behaviorId, occurredOn])
  @@map("annotations")
}

// Unused. The chart does not write here.
model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_log")
}
