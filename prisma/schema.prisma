// Behavior Intelligence — V1 schema
//
// Twelve models: four for identity (Auth.js), two for tenancy, six for the
// behavioral domain.
//
// Two decisions drive most of the shape here and are worth knowing before
// reading further:
//
//   1. A measurement's phase is DERIVED from its session date, not stored.
//      Phase has no foreign key to Measurement. Correcting a phase boundary is
//      therefore a one-row edit rather than a backfill over history.
//
//   2. Measurements keep BOTH the raw entry (as JSON, in whatever shape the
//      measurement type defines) and a single normalized scalar. Charts and
//      statistics only ever read the scalar; the JSON is read only when
//      displaying or editing the original entry.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in
// prisma.config.ts for CLI commands (migrate, seed, studio), and the running
// application passes a driver adapter to the PrismaClient constructor.
// See src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  MEMBER
}

enum MeasurementType {
  FREQUENCY
  RATE
  DURATION
  PERCENTAGE
  LATENCY
  INTERVAL
}

enum MeasurementUnit {
  COUNT
  PER_HOUR
  PERCENT
  SECONDS
}

enum ValueState {
  /// An ordinary observed number.
  VALUE
  /// The true value lies beyond the observation window. Used for latency when
  /// the behavior never occurred: `normalizedValue` holds the lower bound
  /// (the session length), and the real value is "at least" that much.
  CENSORED
  /// The session happened but this behavior could not be measured — no
  /// opportunities arose, or the antecedent was never presented.
  NOT_APPLICABLE
}

enum BehaviorDirection {
  /// More of this behavior is the goal (e.g. independent requests).
  INCREASE
  /// Less of this behavior is the goal (e.g. elopement).
  DECREASE
}

enum PhaseType {
  BASELINE
  INTERVENTION
  MAINTENANCE
  REVERSAL
}

// ---------------------------------------------------------------------------
// Identity — Auth.js v5 with the Prisma adapter, Google OAuth only
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  observedSessions ObservationSession[] @relation("SessionObserver")
  auditLogs        AuditLog[]

  @@map("users")
}

/// One row per external identity. A user who later signs in with a second
/// provider gets a second row here pointing at the same User, which is how
/// "link another provider" works without a schema change.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Login sessions. OAuth providers support Auth.js's database session
/// strategy, so signing out revokes server-side rather than just dropping a
/// cookie the server would still trust.
///
/// Mapped to `auth_sessions` to keep it clearly distinct from
/// ObservationSession, which is the domain concept people will mean when they
/// say "session" in conversation about this app.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Unused with OAuth-only sign-in. Kept because the adapter interface expects
/// it and a future email/magic-link provider would need it.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A workspace that owns clients. In V1 every user gets exactly one personal
/// organization, created automatically on first sign-in, and the word
/// "organization" never appears in the UI.
///
/// It exists now because adding tenancy later means migrating live health
/// records and re-auditing every query at the same time. Building the boundary
/// up front costs two small tables.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]

  @@map("organizations")
}

/// Join table between User and Organization, carrying the role.
///
/// Only OWNER is assigned in V1. Adding ADMIN or VIEWER later is an enum
/// addition plus a permission check, not a data migration.
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

/// The person whose behavior is being measured.
///
/// Deliberately minimal. No date of birth, no external record number, no
/// free-text notes — each is either a HIPAA identifier or a field where
/// protected health information accumulates unstructured. They can be added
/// when a feature actually requires them.
///
/// `organizationId` is the ONLY place tenancy is recorded. Everything below
/// inherits it by descending from a client, which is why tenancy can never
/// drift out of sync.
model Client {
  id             String    @id @default(cuid())
  organizationId String
  /// Initials or a pseudonym, e.g. "J.M." — not a legal name.
  displayName    String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  behaviors    Behavior[]
  sessions     ObservationSession[]

  @@index([organizationId, archivedAt])
  @@map("clients")
}

/// One thing being measured about one client, plus the rules for measuring it.
///
/// Service-layer rule with no schema equivalent: once a behavior has
/// measurements, `measurementType` is immutable. Changing it would silently
/// reinterpret every historical row. The correct user-facing action is to
/// archive the behavior and create a new one.
model Behavior {
  id String @id @default(cuid())

  clientId String

  name String

  /// Observable and unambiguous, so two observers score the same event the
  /// same way. "Leaving the designated instructional area without adult
  /// permission for more than 3 seconds."
  operationalDefinition String

  measurementType MeasurementType

  /// Type-specific settings, validated by that type's `configSchema`.
  /// Interval behaviors store `{ intervalLengthSeconds, style }`; latency
  /// stores the antecedent description. Empty for types that need no config.
  measurementConfig Json @default("{}")

  /// Whether improvement means the line goes up or down. Captured at
  /// definition time because it changes how every downstream statistic is
  /// interpreted.
  direction BehaviorDirection

  targetValue Float?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phases       Phase[]
  measurements Measurement[]
  annotations  Annotation[]

  @@index([clientId, archivedAt])
  @@map("behaviors")
}

/// A named condition applied over a date range: baseline, intervention,
/// maintenance, or reversal.
///
/// Baseline and intervention are the same model distinguished by `phaseType`,
/// because they share identical structure and identical analysis — and because
/// a withdrawal design (A-B-A-B) is then just four ordered rows.
///
/// The range is HALF-OPEN: [startDate, endDate). If a baseline ends on the
/// 27th and an intervention starts on the 27th, a closed interval would put
/// that day in both phases and silently double-count it in both means.
///
/// Attached to a behavior rather than a client, since a client can be in
/// maintenance on one behavior while baseline is still running on another.
model Phase {
  id         String    @id @default(cuid())
  behaviorId String
  /// Free text, e.g. "DRA + break card".
  name       String
  phaseType  PhaseType
  startDate  DateTime  @db.Date
  /// Null means ongoing. At most one open-ended phase per behavior.
  endDate    DateTime? @db.Date

  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  behavior Behavior @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@index([behaviorId, startDate])
  @@map("phases")
}

/// One bounded period of observing one client. Knows nothing about specific
/// behaviors — it is the "when and where" only.
///
/// Session duration lives here and nowhere else, because it is an input to the
/// math: rate divides by it, duration and interval percentages divide by it.
/// If it were repeated per measurement, one bad edit would leave two behaviors
/// from the same session computed against different session lengths.
model ObservationSession {
  id       String  @id @default(cuid())
  clientId String
  /// Nullable: sessions get entered on someone else's behalf. SetNull on
  /// delete, because removing a user must never delete behavior data.
  observerId String?

  /// A DATE, not a timestamp. A session on the 3rd is on the 3rd regardless of
  /// server timezone. Using a timestamp here produces off-by-one-day errors
  /// that move points across phase boundaries and change the reported effect.
  sessionDate DateTime @db.Date

  /// Local wall clock as "HH:mm". A string rather than a time type, because
  /// Prisma maps SQL time to a JavaScript Date and reintroduces exactly the
  /// timezone confusion `@db.Date` above avoids.
  startTime String?

  durationMinutes Int
  setting         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  observer     User?         @relation("SessionObserver", fields: [observerId], references: [id], onDelete: SetNull)
  measurements Measurement[]

  @@index([clientId, sessionDate])
  @@map("observation_sessions")
}

/// One data point: the value of one behavior in one session. This is the row
/// that becomes a dot on the chart.
///
/// Read the table as a grid — sessions are rows, behaviors are columns,
/// measurements are the filled cells. The grid is intentionally sparse, and
/// the sparseness carries meaning: no row means the behavior was not tracked
/// that session, while a row holding 0 means the behavior genuinely did not
/// occur. Conflating those two produces wrong statistics.
model Measurement {
  id                   String @id @default(cuid())
  observationSessionId String
  behaviorId           String

  /// Duplicated from the behavior on purpose, so the row is self-describing:
  /// an export or a future analysis service can interpret it without joining
  /// back to Behavior and consulting the type registry.
  measurementType MeasurementType

  /// What the practitioner actually recorded, in the shape that measurement
  /// type defines — `{ count }`, `{ numerator, denominator }`, and so on.
  ///
  /// JSON so that adding a measurement type requires no migration. This is
  /// safe specifically because nothing queries it: every chart and statistic
  /// reads `normalizedValue` instead, and this column is parsed only when
  /// displaying or editing the original entry.
  rawEntry Json

  /// The single comparable scalar that all charts and statistics read.
  /// Null when `valueState` is NOT_APPLICABLE.
  ///
  /// Float rather than Decimal: these are derived, already-approximate
  /// physical measurements, not money. Decimal would force `.toNumber()` at
  /// every boundary, including serializing the analysis payload.
  normalizedValue Float?

  valueState ValueState      @default(VALUE)
  unit       MeasurementUnit

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observationSession ObservationSession @relation(fields: [observationSessionId], references: [id], onDelete: Cascade)
  behavior           Behavior           @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@unique([observationSessionId, behaviorId])
  @@index([behaviorId])
  @@map("measurements")
}

/// A dated note explaining context: "medication change", "new paraprofessional".
///
/// Distinct from a Phase because it is a point in time with no duration and no
/// effect being measured. A token economy is a phase; a fire drill is an
/// annotation.
model Annotation {
  id         String   @id @default(cuid())
  behaviorId String
  occurredOn DateTime @db.Date
  title      String
  body       String?
  createdAt  DateTime @default(now())

  behavior Behavior @relation(fields: [behaviorId], references: [id], onDelete: Cascade)

  @@index([behaviorId, occurredOn])
  @@map("annotations")
}

/// Append-only record of who changed what.
///
/// `userId` is nullable with SetNull, and `entityId` is a plain string rather
/// than a foreign key, so the log survives deletion of both the actor and the
/// thing described. An audit log with cascading deletes is not an audit log.
///
/// Never put protected health information in `metadata`: log that a value
/// changed and by whom, not the client's name or clinical notes.
model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  /// Dotted action name, e.g. "behavior.create", "phase.update".
  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_log")
}
