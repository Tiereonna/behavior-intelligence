# Copy this file to `.env` and fill in values for your machine.
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.

# Local PostgreSQL connection string.
#
# Postgres.app uses local trust authentication, so there is no password in
# development. Replace USER with your macOS username (run `whoami`).
DATABASE_URL="postgresql://USER@localhost:5432/behavior_intelligence?schema=public"
